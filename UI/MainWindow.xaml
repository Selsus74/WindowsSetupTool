<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="WindowsSetupTool.UI.MainWindow"
        Icon="pack://application:,,,/Resources/WindowsSetupTool.ico"
        Title="Windows Setup Tool"
        Height="650"
        Width="850"
        MinHeight="550"
        MinWidth="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">

    <!-- ===== Base Grid ===== -->
    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===== HEADER ===== -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Windows Setup Tool"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>

            <TextBlock Text="Ersteinrichtung eines Windows-PCs"
                       FontSize="15"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- ===== SYSTEM INFORMATION ===== -->

        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="Computer"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

                <TextBlock Grid.Column="1"
                           x:Name="ComputerNameText"
                           Margin="10,0,30,0"
                           Foreground="{StaticResource TextBrush}"/>


                <TextBlock Grid.Column="2"
                           Text="Benutzer"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

                <TextBlock Grid.Column="3"
                           x:Name="UserNameText"
                           Margin="10,0,0,0"
                           Foreground="{StaticResource TextBrush}"/>

            </Grid>

        </Border>


        <!-- ===== TASKS ===== -->

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0"
                      Margin="0,0,-12,0">

            <StackPanel>
                <!-- ===== Group: System ===== -->

                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>

                        <TextBlock Text="System"
                   Style="{StaticResource GroupTitle}"/>

                        <TextBlock Text="Energie, Updates und Dienste."
                   Style="{StaticResource GroupHint}"/>

                        <Border Style="{StaticResource GroupSeparator}"/>

                        <StackPanel x:Name="SystemTaskPanel"/>

                    </StackPanel>
                </Border>

                <!-- ===== Group: Users ===== -->

                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>

                        <TextBlock Text="Benutzer"
                   Style="{StaticResource GroupTitle}"/>

                        <TextBlock Text="Konto, Anmeldung und persönliche Einstellungen."
                   Style="{StaticResource GroupHint}"/>

                        <Border Style="{StaticResource GroupSeparator}"/>

                        <StackPanel x:Name="UserTaskPanel"/>

                    </StackPanel>
                </Border>

                <!-- ===== Group: Explorer ===== -->

                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>

                        <TextBlock Text="Explorer"
                                   Style="{StaticResource GroupTitle}"/>

                        <TextBlock Text="Anzeigeoptionen und Verhalten des Datei-Explorers."
                                   Style="{StaticResource GroupHint}"/>

                        <Border Style="{StaticResource GroupSeparator}"/>

                        <StackPanel x:Name="ExplorerTaskPanel"/>

                    </StackPanel>
                </Border>

                <!-- ===== Group: Software ===== -->

                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>

                        <TextBlock Text="Software"
                   Style="{StaticResource GroupTitle}"/>

                        <TextBlock Text="Benötigte Software wählen."
                   Style="{StaticResource GroupHint}"/>

                        <Border Style="{StaticResource GroupSeparator}"/>

                        <StackPanel x:Name="SoftwareTaskPanel"/>

                    </StackPanel>
                </Border>

                <!-- ===== Group: Template (templated) ===== -->

                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>

                        <TextBlock Text="Template"
                                   Style="{StaticResource GroupTitle}"/>

                        <TextBlock Text="Template."
                                   Style="{StaticResource GroupHint}"/>

                        <Border Style="{StaticResource GroupSeparator}"/>

                        <StackPanel x:Name="TempTaskPanel"/>

                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- ===== PROGRESS ===== -->

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,15">

            <Grid>

                <TextBlock Text="Fortschritt"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="ProgressText"
                           Text="0%"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

            </Grid>


            <ProgressBar x:Name="SetupProgress"
                         Height="8"
                         Margin="0,8,0,0"/>


            <TextBlock x:Name="StatusText"
                Text="Bereit."
                Foreground="{StaticResource SecondaryTextBrush}"
                FontSize="13"
                Margin="0,7,0,0"/>

        </StackPanel>


        <!-- ===== BUTTONS ===== -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="startSetupButton"
                    Content="Einrichtung starten"
                    Width="180"
                    Height="38"
                    Style="{StaticResource PrimaryButton}"
                    Click="StartSetup_Click"/>

        </StackPanel>

    </Grid>

</Window>