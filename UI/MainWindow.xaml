<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="WindowsSetupTool.UI.MainWindow"
        Title="Windows Setup Tool"
        Height="650"
        Width="850"
        MinHeight="550"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#181A1F"
        Foreground="#F1F3F5">

    <Window.Resources>

        <!-- colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#181A1F"/>
        <SolidColorBrush x:Key="CardBrush" Color="#22252B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#30343C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F3F5"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9DA3AE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA0FF"/>

        <!-- standard buttons -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2A2E36"/>
            <Setter Property="Foreground" Value="#F1F3F5"/>
            <Setter Property="BorderBrush" Value="#3A3F49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#353A44"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#4C8DFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1F2228"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PrimaryButton -->
        <Style x:Key="PrimaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A73D9"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar -->
        <Style TargetType="{x:Type ProgressBar}">

            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Windows Setup Tool"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>

            <TextBlock Text="Ersteinrichtung eines Windows-PCs"
                       FontSize="15"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- ================= SYSTEM INFORMATION ================= -->

        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="Computer"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

                <TextBlock Grid.Column="1"
                           x:Name="ComputerNameText"
                           Margin="10,0,30,0"
                           Foreground="{StaticResource TextBrush}"/>


                <TextBlock Grid.Column="2"
                           Text="Benutzer"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

                <TextBlock Grid.Column="3"
                           x:Name="UserNameText"
                           Margin="10,0,0,0"
                           Foreground="{StaticResource TextBrush}"/>

            </Grid>

        </Border>


        <!-- ================= TASKS ================= -->

        <!-- ================= Explorer ============== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18" Margin="395,0,0,140">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="Explorer"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>


                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="TaskPanel"/>

                </ScrollViewer>

            </Grid>

        </Border>

        <!-- ================= User ============== -->
        <Border Grid.Row="2"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18" Margin="0,0,395,140">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                    Text="User"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Margin="0,0,0,15"/>


                <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="TaskPanel1"/>

                </ScrollViewer>

            </Grid>

        </Border>


        <!-- ================= PROGRESS ================= -->

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,15">

            <Grid>

                <TextBlock Text="Fortschritt"
                           FontWeight="SemiBold"/>

                <TextBlock Text="0%"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

            </Grid>


            <ProgressBar x:Name="SetupProgress"
                         Height="8"
                         Margin="0,8,0,0"/>


            <TextBlock x:Name="StatusText"
                Text="Bereit."
                Foreground="{StaticResource SecondaryTextBrush}"
                FontSize="13"
                Margin="0,7,0,0"/>

        </StackPanel>


        <!-- ================= BUTTONS ================= -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Einrichtung starten"
                    Width="180"
                    Height="38"
                    Style="{StaticResource PrimaryButton}"
                    Click="StartSetup_Click"/>

        </StackPanel>

    </Grid>

</Window>