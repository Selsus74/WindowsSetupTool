<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Base ===== -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#30343C"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#181A1F"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="CardBrush" Color="#22252B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#30343C"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2E323A"/>

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="TextBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9DA3AE"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="White"/>

    <!-- ===== Accent ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA0FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A73D9"/>

    <!-- ===== Controls ===== -->
    <SolidColorBrush x:Key="ControlBrush" Color="#2A2E36"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A3F49"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#353A44"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#1F2228"/>

    <!-- ===== Disabled ===== -->
    <SolidColorBrush x:Key="DisabledBrush" Color="#555555"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#AAAAAA"/>

    <!-- ===== Scrollbar ===== -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3F49"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4E5560"/>
    
    <!-- ===== Visual Feedback Colors(lol) ===== -->
    <SolidColorBrush x:Key="GreenBrush" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#6BA0FF"/>
    <SolidColorBrush x:Key="RedBrush" Color="#3A73D9"/>

</ResourceDictionary>